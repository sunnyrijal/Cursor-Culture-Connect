{
  "expo": {
    "name": "TRiVO",
    "slug": "trivo-connect-ios",
    "version": "0.0.2",
    "orientation": "default",
    "icon": "./assets/logo.png",
    "scheme": "myapp",
    "owner": "kamalaryal",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff",
      "dark": {
        "image": "./assets/logo.png",
        "backgroundColor": "#000000"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.trivo.connect",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "We use your photo library to let you upload a profile picture to your account.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.trivo.connect",
      "permissions": [
        "NOTIFICATIONS",
        "VIBRATE",
        "WAKE_LOCK"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/logo.png"
    },
    "plugins": ["expo-router", "expo-font", "expo-web-browser"],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cf643482-bae7-4ceb-9802-0c8db379cf8f"
      }
    }
  }
}
