{
  "expo": {
    "name": "TRiVO",
    "slug": "bolt-expo-nativewind",
    "version": "1.0.1",
    "orientation": "default",
    "icon": "./assets/logo.png",
    "scheme": "myapp",
    "owner": "rijalboy1",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff",
      "dark": {
        "image": "./assets/logo.png",
        "backgroundColor": "#000000"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.trivo.connect",
      "buildNumber": "26",
      "googleServicesFile": "./google-services/GoogleService-Info.plist",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "We use your photo library to let you upload a profile picture to your account.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "notification": {
        "icon": "./assets/logo.png"
      }
    },
    "android": {
      "package": "com.trivo.connect",
      "googleServicesFile": "./google-services/google-services.json",
      "permissions": ["NOTIFICATIONS", "VIBRATE", "WAKE_LOCK"],
      "notification": {
        "icon": "./assets/logo.png",
        "color": "#FF231F7C"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/logo.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-notifications",
      "@react-native-firebase/app",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "15.1",
            "useFrameworks": "static",
            "extraPods": [
              { "name": "GoogleUtilities", "modular_headers": true }
            ]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fecb2cb4-c2cd-4536-a6c8-fea3c961c70c"
      }
    }
  }
}
